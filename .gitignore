# --- data (large, never commit) ---
data/raw/*
!data/raw/.gitkeep
*.tif
*.tiff
*.tar.gz

# --- model weights / checkpoints (large, never commit) ---
experiments/checkpoints/*
!experiments/checkpoints/.gitkeep

# --- Kaggle run outputs: outputs/ (results, logs, all 26 trained checkpoints) IS tracked
#     so a fresh clone runs the full app. Only the intermediate per-job folder is ignored. ---
outputs/jobs/
*.zip

# --- local tool config ---
.claude/

# --- python ---
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
*.egg-info/

# --- OS junk ---
.DS_Store
Thumbs.db

# --- secrets ---
*.env
kaggle.json

# --- local scratch ---
install_log.txt
scan_log.txt

# --- local runs of notebooks/train_clearsar.py ---
outputs/final_run/
